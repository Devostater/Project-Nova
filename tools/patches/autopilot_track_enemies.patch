         const destPos = destObj.getWorldPosition ? destObj.getWorldPosition(new THREE.Vector3()) : destObj.position.clone();   // world position (targets inside groups)
         try { if (!destObj.userData.apR) { const bs = new THREE.Box3().setFromObject(destObj).getBoundingSphere(new THREE.Sphere()); destObj.userData.apR = isFinite(bs.radius) ? Math.min(bs.radius, 600) : 0; } } catch (e) { }
         safeStandoffDist = Math.max(safeStandoffDist, (destObj.userData.apR || 0) + 40);   // keep clear of the hull, whatever its size
         const toDest = destPos.clone().sub(shipGroup.position);
