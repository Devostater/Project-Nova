         const desiredDir = toDest.clone().normalize();
         const desiredQuat = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 0, -1), desiredDir);
         shipGroup.quaternion.slerp(desiredQuat, 2.8 * delta);
