# Keep text files with LF line endings in the repo, whatever the editor or OS.
# (A CRLF conversion rewrites every line of the 18k-line game file and breaks merges.)
* text=auto eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
# Windows scripts keep CRLF so they run in cmd.exe
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.glb binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.ico binary
